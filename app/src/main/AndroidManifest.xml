<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.example.musicsourceseparation.permission.INTERNAL_BENCHMARK"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.example.musicsourceseparation.permission.INTERNAL_BENCHMARK" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".benchmark.InferenceBenchmarkService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".benchmark.applive.AppLiveValidationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
