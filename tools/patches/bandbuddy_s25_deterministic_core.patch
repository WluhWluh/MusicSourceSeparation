+    @Test
+    fun gpuCandidateSingleWindowProbe() {
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        val candidate = requireNotNull(
+            androidx.test.platform.app.InstrumentationRegistry.getArguments()
+                .getString("gpuCandidate"),
+        ) { "Pass -e gpuCandidate gpu-fp16|gpu-fp32|gpu-broad-fp16|gpu-broad-fp32" }
+        val modelFile = File(context.filesDir, "diagnostic-8s/htdemucs_6s.core.8s.fp16-safe.tflite")
+        check(modelFile.isFile && modelFile.length() == 117_784_760L) {
+            "Missing verified original-window candidate: $modelFile"
+        }
+        val precision = when (candidate) {
+            "gpu-fp16", "gpu-broad-fp16" -> QnnDelegate.Options.GpuPrecision.GPU_PRECISION_FP16
+            "gpu-fp32", "gpu-broad-fp32" -> QnnDelegate.Options.GpuPrecision.GPU_PRECISION_FP32
+            else -> error("Unknown gpuCandidate=$candidate")
+        }
+        val skippedNodes = when (candidate) {
+            "gpu-broad-fp16", "gpu-broad-fp32" ->
+                ((1_291..2_203) + listOf(3_307, 3_487)).toIntArray()
+            else -> null
+        }
+        val resultRoot = File(
+            requireNotNull(context.getExternalFilesDir(null)),
+            "gpu-probe/$candidate",
+        ).apply {
+            if (exists()) deleteRecursively()
+            check(mkdirs())
+        }
+        val cache = File(context.codeCacheDir, "gpu-probe-$candidate-v1").apply {
+            if (exists()) deleteRecursively()
+            check(mkdirs())
+        }
+        val result = runCatching {
+            val options = QnnDelegate.Options().apply {
+                setCacheDir(cache.absolutePath)
+                setModelToken("bandbuddy-gpu-probe-$candidate-a9fcc89e-v1")
+                setBackendType(QnnDelegate.Options.BackendType.GPU_BACKEND)
+                setGpuPrecision(precision)
+                setGpuPerformanceMode(QnnDelegate.Options.GpuPerformanceMode.GPU_PERFORMANCE_HIGH)
+                setProfiling(QnnDelegate.Options.ProfilingOptions.BASIC_PROFILING)
+                setLogLevel(QnnDelegate.Options.LogLevel.LOG_LEVEL_INFO)
+                skippedNodes?.let(::setSkipNodeIds)
+            }
+            val delegate = QnnDelegate(options)
+            try {
+                check(delegate.isAvailable) { "GPU delegate unavailable for $candidate" }
+                val mappedModel = FileInputStream(modelFile).channel.use { channel ->
+                    channel.map(java.nio.channels.FileChannel.MapMode.READ_ONLY, 0L, channel.size())
+                }
+                val samples = 343_980
+                val frames = 336
+                val mix = direct(2 * samples)
+                val spec = direct(4 * 2_048 * frames)
+                val frequency = direct(6 * 4 * 2_048 * frames)
+                val time = direct(6 * 2 * samples)
+                fillDeterministicCoreInputs(mix, spec)
+                val started = SystemClock.elapsedRealtime()
+                Interpreter(mappedModel, Interpreter.Options().apply {
+                    setUseXNNPACK(true)
+                    setNumThreads(4)
+                    addDelegate(delegate)
+                }).use { interpreter ->
+                    check(interpreter.getInputTensor(0).shape().contentEquals(intArrayOf(1, 2, samples)))
+                    check(interpreter.getInputTensor(1).shape().contentEquals(intArrayOf(1, 4, 2_048, frames)))
+                    val inferenceStarted = System.nanoTime()
+                    interpreter.runForMultipleInputsOutputs(
+                        arrayOf(mix, spec),
+                        mutableMapOf<Int, Any>(0 to frequency, 1 to time),
+                    )
+                    val inferenceWallNanos = System.nanoTime() - inferenceStarted
+                    frequency.rewind()
+                    time.rewind()
+                    check(frequency.get().isFinite() && time.get().isFinite()) {
+                        "GPU output contains NaN/Infinity"
+                    }
+                    val report = buildString {
+                        append("candidate=").append(candidate)
+                        append(" preparePlusInferenceMs=")
+                            .append(SystemClock.elapsedRealtime() - started)
+                        append(" inferenceWallMs=").append(inferenceWallNanos / 1_000_000.0)
+                        append(" nativeInferenceMs=")
+                            .append(interpreter.lastNativeInferenceDurationNanoseconds?.div(1_000_000.0))
+                    }
+                    File(resultRoot, "result.txt").writeText(report, Charsets.UTF_8)
+                    Log.i("BandBuddyGpuProbe", report)
+                }
+            } finally {
+                delegate.close()
+            }
+        }
+        result.onFailure { error ->
+            val report = buildString {
+                append("candidate=").append(candidate)
+                append(" failure=").append(error::class.java.name)
+                append(" message=").append(error.message.orEmpty())
+            }
+            File(resultRoot, "failure.txt").writeText(report, Charsets.UTF_8)
+            Log.e("BandBuddyGpuProbe", report, error)
+        }
+        result.getOrThrow()
+    }
