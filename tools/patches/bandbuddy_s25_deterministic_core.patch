+    private fun fillDeterministicCoreInputs(mix: FloatBuffer, spec: FloatBuffer) {
+        repeat(mix.capacity()) { index ->
+            mix.put(index, (((index * 17) % 257) - 128) / 512f)
+        }
+        repeat(spec.capacity()) { index ->
+            spec.put(index, (((index * 29) % 251) - 125) / 512f)
+        }
+        mix.rewind()
+        spec.rewind()
+    }
+
+    private fun exportCoreOutputs(
+        context: Context,
+        backend: String,
+        frequency: FloatBuffer,
+        time: FloatBuffer,
+    ) {
+        val export = File(
+            requireNotNull(context.getExternalFilesDir(null)),
+            "deterministic-core/$backend",
+        ).apply {
+            if (exists()) deleteRecursively()
+            check(mkdirs())
+        }
+        writeFloatBuffer(File(export, "frequency.f32le"), frequency)
+        writeFloatBuffer(File(export, "time.f32le"), time)
+        Log.i("BandBuddyCoreProbe", "backend=$backend output=${export.absolutePath}")
+    }
